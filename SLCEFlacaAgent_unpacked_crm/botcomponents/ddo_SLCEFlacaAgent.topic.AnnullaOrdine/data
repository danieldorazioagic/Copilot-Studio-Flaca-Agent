kind: AdaptiveDialog
modelDescription: Usalo quando l'utente vuole annullare, cancellare o rimuovere un ordine di oggi, proprio o di un collega taggato.
beginDialog:
  kind: OnRecognizedIntent
  id: main
  intent:
    displayName: Annulla Ordine

  actions:
    - kind: SetVariable
      id: setUPN
      variable: Topic.UtenteUPN
      value: =System.User.PrincipalName

    - kind: SetVariable
      id: initEsito
      variable: Topic.esito
      value: =Text("")

    - kind: InvokeAIBuilderModelAction
      id: promptRiconosciSoggetto
      input:
        binding:
          UserRequest: =System.Activity.Text

      output:
        binding:
          predictionOutput: Topic.SoggettoOutput

      aIModelId: 4c135db1-daab-472b-8f7f-c9f4d02b3975

    - kind: SetVariable
      id: setSoggetto
      variable: Topic.Soggetto
      value: =Trim(Topic.SoggettoOutput.text)

    - kind: ConditionGroup
      id: checkSoggettoAltri
      conditions:
        - id: annullaPerAltri
          condition: =!IsBlank(Topic.Soggetto) And Upper(Topic.Soggetto) <> "ME"
          actions:
            - kind: SetVariable
              id: setUPNAltri
              variable: Topic.UtenteUPN
              value: =Topic.Soggetto

    - kind: InvokeFlowAction
      id: invokeFlowAction_dX19Yy
      input:
        binding:
          text: =Topic.UtenteUPN

      output:
        binding:
          text: Topic.esito

      flowId: 1a2b3c4d-5e6f-f111-ab0d-7c1e52357b27

    - kind: ConditionGroup
      id: checkEsito
      conditions:
        - id: esitoAnnullato
          condition: =Topic.esito = "annullato"
          actions:
            - kind: SendActivity
              id: msgAnnullato
              activity: ✅ Ordine annullato con successo!

            - kind: InvokeFlowAction
              id: callPubblicaTabellaAnnulla
              input: {}
              output:
                binding:
                  tabella: Topic.TabellaOrdini

              flowId: 2b3c4d5e-6f7a-f111-ab0d-7c1e52357b28

            - kind: SendActivity
              id: msgTabellaAnnulla
              activity: "{Topic.TabellaOrdini}"

        - id: esitoNonTrovato
          condition: =Topic.esito = "non_trovato"
          actions:
            - kind: SendActivity
              id: msgNonTrovato
              activity: ⚠️ Non risulta nessun ordine attivo da annullare per oggi.

        - id: esitoFuoriOrario
          condition: =Topic.esito = "fuori_orario"
          actions:
            - kind: SendActivity
              id: msgFuoriOrarioAnnulla
              activity: ⚠️ Gli ordini di oggi sono già chiusi.

    - kind: EndConversation
      id: UQsbAn

inputType: {}
outputType: {}