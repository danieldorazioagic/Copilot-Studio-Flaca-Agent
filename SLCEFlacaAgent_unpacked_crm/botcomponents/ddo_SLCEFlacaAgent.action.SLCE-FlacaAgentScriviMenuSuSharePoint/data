kind: TaskDialog
modelDescription: "Scrive piatti su SharePoint. Solo per configurazione menu. "
action:
  kind: InvokeFlowTaskAction
  flowId: 0c130643-6872-f111-ab0d-000d3a693112
  connectionProperties:
    $kind: ConnectionProperties
    diagnostics:
    mode: Invoker

outputMode: All
description: Scrive i piatti del menu giornaliero su SharePoint (lista FlacaMenu). Usare solo per configurare il menu del giorno, mai durante la raccolta ordini degli utenti.
inputType:
  properties:
    text:
      description: Lista dei piatti separati da virgola (es. "Pasta al pomodoro,Insalata di pollo,Cotoletta").
      title: piattiCSV
      type: String

    text_1:
      description: Data del menu nel formato yyyy-MM-dd (es. "2026-07-28").
      title: dataMenu
      type: String

    text_2:
      description: Categoria dei piatti (es. "Primi", "Secondi", "Insalate", "Burger").
      title: categoria
      type: String