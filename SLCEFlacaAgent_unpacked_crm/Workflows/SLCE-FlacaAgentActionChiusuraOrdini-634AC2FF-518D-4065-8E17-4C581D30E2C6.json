      },
      "actions": {
        "Inizializza_MessaggioRiepilogo": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "d4000001-0001-0001-0001-000000000001"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "MessaggioRiepilogo",
                "type": "string",
                "value": "**🍽️ Riepilogo ordini per La Flaca:**\n\n"
              }
            ]
          }
        },
        "Leggi_Ordini_Oggi": {
          "runAfter": {
            "Inizializza_MessaggioRiepilogo": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "d4000002-0002-0002-0002-000000000002"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline_1",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('SL CE - Flaca Agent | Url SharePoint (ddo_SLCEFlacaAgentUrlSharePoint)')",
              "table": "38a33006-7b17-4a37-adfe-6f08299c1097",
              "$filter": "@concat('DataOrdine ge ''', formatDateTime(utcNow(), 'yyyy-MM-dd'), 'T00:00:00Z'' and DataOrdine lt ''', formatDateTime(addDays(utcNow(), 1), 'yyyy-MM-dd'), 'T00:00:00Z''')",
              "$top": 200
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Condizione_Ordini_Presenti": {
          "actions": {
            "Seleziona_Piatti": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "d4000004-0004-0004-0004-000000000004"
              },
              "type": "Select",
              "inputs": {
                "from": "@body('Leggi_Ordini_Oggi')?['value']",
                "select": "@item()?['Piatto']"
              }
            },
            "Calcola_Piatti_Unici": {
              "runAfter": {
                "Seleziona_Piatti": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "d4000005-0005-0005-0005-000000000005"
              },
              "type": "Compose",
              "inputs": "@union(body('Seleziona_Piatti'), body('Seleziona_Piatti'))"
            },
            "Foreach_Piatto_Unico": {
              "foreach": "@outputs('Calcola_Piatti_Unici')",
              "actions": {
                "Filtra_Ordini_Piatto": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "d4000006-0006-0006-0006-000000000006"
                  },
                  "type": "Query",
                  "inputs": {
                    "from": "@body('Leggi_Ordini_Oggi')?['value']",
                    "where": "@equals(item()?['Piatto'], items('Foreach_Piatto_Unico'))"
                  }
                },
                "Aggiungi_Riga_Riepilogo": {
                  "runAfter": {
                    "Filtra_Ordini_Piatto": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "d4000007-0007-0007-0007-000000000007"
                  },
                  "type": "AppendToStringVariable",
                  "inputs": {
                    "name": "MessaggioRiepilogo",
                    "value": "@{items('Foreach_Piatto_Unico')} → @{length(body('Filtra_Ordini_Piatto'))}\n\n"
                  }
                }
              },
              "runAfter": {
                "Calcola_Piatti_Unici": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "d4000008-0008-0008-0008-000000000008"
              },
              "type": "Foreach",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              }
            }
          },
          "runAfter": {
            "Leggi_Ordini_Oggi": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Aggiungi_Riga_Vuota": {
                "runAfter": {},
                "metadata": {
                  "operationMetadataId": "d4000009-0009-0009-0009-000000000009"
                },
                "type": "AppendToStringVariable",
                "inputs": {
                  "name": "MessaggioRiepilogo",
                  "value": "Nessun ordine ricevuto oggi.\n\n"
                }
              }
            }
          },
          "expression": {
            "greater": [
              "@length(body('Leggi_Ordini_Oggi')?['value'])",
              0
            ]
          },
          "metadata": {
            "operationMetadataId": "d400000a-000a-000a-000a-00000000000a"
          },
          "type": "If"
        },
        "Respond_to_the_agent": {
          "runAfter": {
            "Condizione_Ordini_Presenti": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "d400000c-000c-000c-000c-00000000000c"
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "body": {
              "esito": "ok",
              "messaggioChiusura": "⏱️ Ordini chiusi. Sto preparando il riepilogo per La Flaca.",
              "riepilogo": "@{variables('MessaggioRiepilogo')}"
            },
            "schema": {
              "type": "object",
              "properties": {
                "esito": {
                  "title": "esito",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                },
                "messaggioChiusura": {
                  "title": "messaggioChiusura",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                },
                "riepilogo": {
                  "title": "riepilogo",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
