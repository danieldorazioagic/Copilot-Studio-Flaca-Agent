kind: AdaptiveDialog
beginDialog:
  kind: OnRecognizedIntent
  id: main
  intent:
    displayName: Raccolta Ordini
    triggerQueries:
      - ordino
      - voglio ordinare
      - scelgo
      - prendo
      - vorrei
      - mi segni
      - prendo il
      - scelgo il numero
      - il numero
      - per me
      - metto
      - prenota per me
      - il mio ordine
      - mando l'ordine
      - confermo

  actions:
    - kind: SetVariable
      id: setUPN
      variable: Topic.UtenteUPN
      value: =System.User.PrincipalName

    - kind: SetVariable
      id: initNomePiatto
      variable: Topic.NomePiatto
      value: =Text("")

    - kind: SetVariable
      id: initNumeroPiatto
      variable: Topic.NumeroPiatto
      value: "0"

    - kind: SetVariable
      id: initNumeroPiattoInt
      variable: Topic.NumeroPiattoInt
      value: =0

    - kind: SetVariable
      id: initInputOrdine
      variable: Topic.InputOrdine
      value: =System.Activity.Text

    - kind: SetVariable
      id: initEsito
      variable: Topic.Esito
      value: =Text("")

    - kind: Question
      id: askPiatto
      alwaysPrompt: false
      variable: Topic.InputOrdine
      prompt:
        activity:
          text: Scrivi il numero o il nome del piatto che vuoi ordinare.

      entity: StringPrebuiltEntity

    - kind: InvokeFlowAction
      id: callValidaOrdine
      input:
        binding:
          text: =Topic.InputOrdine

        text: =Topic.InputOrdine

      output:
        binding:
          text: Topic.NomePiatto
          text_1: Topic.NumeroPiatto

      flowId: cbbc79f7-2076-f111-ab0d-7c1e52357b26

    - kind: ConditionGroup
      id: checkTrovato
      conditions:
        - id: piattoTrovato
          condition: =!IsBlank(Topic.NomePiatto)
          actions:
            - kind: SetVariable
              id: setNumeroPiattoInt
              variable: Topic.NumeroPiattoInt
              value: =Value(Topic.NumeroPiatto)

            - kind: InvokeFlowAction
              id: callRegistraOrdine
              input:
                binding:
                  number: =Topic.NumeroPiattoInt
                  text: =Topic.UtenteUPN
                  text_1: =Topic.NomePiatto

                number: =Topic.NumeroPiattoInt
                text: =Topic.UtenteUPN
                text_1: =Topic.NomePiatto

              output:
                binding:
                  text: Topic.Esito

              flowId: 470a3e38-1b76-f111-ab0d-7c1e52357b26

            - kind: ConditionGroup
              id: checkEsito
              conditions:
                - id: esitoNuovo
                  condition: =Topic.Esito = "nuovo"
                  actions:
                    - kind: SendActivity
                      id: msgNuovo
                      activity: "✅ Ordine registrato con successo!"

                - id: esitoAggiornato
                  condition: =Topic.Esito = "aggiornato"
                  actions:
                    - kind: SendActivity
                      id: msgAggiornato
                      activity: "✅ Ordine aggiornato con successo!"

                - id: esitoFuoriOrario
                  condition: =Topic.Esito = "fuori_orario"
                  actions:
                    - kind: SendActivity
                      id: msgFuoriOrario
                      activity: "⚠️ Gli ordini di oggi sono già chiusi."

        - id: piattoNonTrovato
          condition: =IsBlank(Topic.NomePiatto)
          actions:
            - kind: SendActivity
              id: msgPiattoNonTrovato
              activity: "⚠️ Il piatto indicato non è presente nel menu di oggi. Per favore scegli uno dei piatti disponibili."

inputType: {}
outputType: {}